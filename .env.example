# MiMo Reasoning Playground - Environment Configuration
# Copy this to .env and fill in your values

# MiMo API endpoint (Xiaomi official or proxy)
MIMO_API_BASE=https://api.xiaomi.com/v1
MIMO_API_KEY=your-api-key-here

# Model configuration
MIMO_MODEL=xmtp/mimo-v2.5-pro
MIMO_MAX_TOKENS=8192
MIMO_TEMPERATURE=0.7

# Server
HOST=0.0.0.0
PORT=8501
